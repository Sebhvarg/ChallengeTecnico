# ============================================================================
# VARIABLES DE ENTORNO PARA DESPLIEGUE DOCKER (AWS EC2 / PRODUCCIÓN)
# ============================================================================

# Contraseña del usuario 'sa' de SQL Server (Debe cumplir política de complejidad: mayúsculas, minúsculas, números, caracteres especiales)
DB_PASSWORD=xxxx
DB_PORT=1433

# Configuración del Backend (.NET 8)
BACKEND_PORT=5000
JWT_KEY=xxxx
JWT_ISSUER=InventoryApi
JWT_AUDIENCE=InventoryAngularClient

# Puertos del Frontend (Nginx)
FRONTEND_PORT=80
FRONTEND_DEV_PORT=4200
